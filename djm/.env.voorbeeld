# Kopieer naar .env (staat niet in git) en vul in. Echte waarden staan in de kluis van de beheerder.
APP_URL=https://<fotosite-domein>
# Overnemen uit de v6-installatie (config/.env) of nieuw maken: echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:<sleutel>
# IP van de reverse proxy die voor Lychee staat
TRUSTED_PROXIES=<proxy-ip>
DB_PASSWORD=<wachtwoord>
DB_ROOT_PASSWORD=<wachtwoord>
# Poort op de host (de proxy wijst hierheen)
APP_PORT=8080
# Tijdelijk een upstream-image gebruiken in plaats van ons eigen build:
# LYCHEE_IMAGE=ghcr.io/lycheeorg/lychee:v7.11.1
